# Copy to ~/.config/grokbot/webhook.env (owner-only). Never commit the filled file.
# Values come from the Grok Bot intake routine. Quotes are optional. The senders parse this file as data.
GROKBOT_WEBHOOK_URL="PASTE_WEBHOOK_URL_HERE"
# Full Authorization header value, scheme word included.
GROKBOT_WEBHOOK_AUTH="PASTE_AUTHORIZATION_HEADER_VALUE_HERE"
